#!/usr/bin/env bash
#
# towebm — convert an mp4 (or any ffmpeg-readable video) to webm.
#
# Usage:
#   ./bin/towebm ./source.mp4 ./target.webm
#   ./bin/towebm ./source.mp4              # writes ./source.webm
#
set -euo pipefail

usage() {
  echo "Usage: $(basename "$0") <source.mp4> [target.webm]" >&2
  exit 1
}

if [[ $# -lt 1 || $# -gt 2 ]]; then
  usage
fi

source="$1"

if [[ ! -f "$source" ]]; then
  echo "Error: source file not found: $source" >&2
  exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "Error: ffmpeg is not installed or not on PATH" >&2
  exit 1
fi

# Default the target to the source filename with a .webm extension.
target="${2:-${source%.*}.webm}"

ffmpeg -i "$source" -c:v libvpx-vp9 -crf 31 -b:v 0 -c:a libvorbis "$target"

echo "Wrote $target"
